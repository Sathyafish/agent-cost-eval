# Langfuse (self-hosted via docker compose; create a project + keys at http://localhost:3000)
LANGFUSE_HOST=http://localhost:3000
# Address your browser uses to open trace links (set to http://<ec2-public-ip>:3000 on EC2)
LANGFUSE_PUBLIC_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
NUM_CTX=16384

# Token prices in USD per token. PLACEHOLDERS: Ollama is free; these only make Langfuse show dollar costs.
INPUT_PRICE_PER_TOKEN=0.000003
OUTPUT_PRICE_PER_TOKEN=0.000015
